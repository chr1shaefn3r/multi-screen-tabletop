# Password for the game master. Only someone who knows it can open tables.
HOST_SECRET=change-me-to-something-long

# Set automatically when you connect a Redis database in Vercel → Storage.
# Leave empty locally: the dev server then uses an in-memory store.
REDIS_URL=

# Optional: JSON list of STUN/TURN servers (add TURN if devices can't connect directly).
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:example.com:3478","username":"u","credential":"p"}]

# Optional: "debug" also logs the routine polling requests.
# LOG_LEVEL=debug
